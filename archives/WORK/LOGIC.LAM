;;; Test to check out logic programming in HORSE

(define member
   (lambda (element list cont)
      (or (lambda (x xs) (and (unify element x)
                              (unify list [x | xs])
                              cont))
          (lambda (y ys) (and (unify list [y | ys])
                              (member element ys cont))))))


(define test1-1 (member b [a b c] true))
(define test1-2 (lambda (x) answer (member x [a b c] true) x))
(define test1-3 (lambda (x) answer (member a x true) x))


(define append
   (lambda (list1 list2 applist cont)
      (or (and (unify list1 [])
               (unify list2 applist)
               cont)
         (lambda (x xs zs)
            (and  (unify list1 [x|xs])
                  (unify applist [x|zs])
                  (append xs list2 zs cont))))))


(define test2-1 (append [1 2] [3 4] [1 2 3 4] true))
(define test2-2 (lambda (x) answer (append [1 2] [3 4] x true) x))
(define test2-3 (lambda (x) answer (append [1 2] x [1 2 3 4] true) x))
(define test2-4 (lambda (x) answer (append x [3 4] [1 2 3 4] true) x))
                     

(define p (lambda (x cont) (or   (and (unify x 1) cont)
                                 (and (unify x 2) cont))))

(define q (lambda (x cont) (or   (and (unify x 2) cont)
                                 (and (unify x 3) cont))))

(define test3-1 (lambda (x) answer (and (p x (q x true))) x))

